#!/usr/bin/env bash
set -euo pipefail

export HOST_UID="${HOST_UID:-$(id -u)}"
export HOST_GID="${HOST_GID:-$(id -g)}"
export HOST_HOME="${HOST_HOME:-$HOME}"

ENV_FILE=("--env-file" ".docker-env")
[ -f .docker-env ] || ENV_FILE=()

# Container starts as root (for iptables setup), so exec commands
# need an explicit user to avoid running as root.
if [ "${1:-}" = "exec" ]; then
    # Insert --user after "exec" unless the caller already passed -u/--user
    shift
    has_user=false
    for arg in "$@"; do
        case "$arg" in -u|--user) has_user=true; break;; esac
    done
    if [ "$has_user" = false ]; then
        exec docker compose "${ENV_FILE[@]}" exec --user "${HOST_UID}:${HOST_GID}" "$@"
    else
        exec docker compose "${ENV_FILE[@]}" exec "$@"
    fi
fi

exec docker compose "${ENV_FILE[@]}" "$@"
